---
import { site } from '../data/site';
import { assetUrl } from '../lib/assets';
import headingFont from '../assets/fonts/space-grotesk-latin.woff2?url';
import bodyFont from '../assets/fonts/inter-latin.woff2?url';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/motion.css';
// Foreground refinements load last without replacing the approved background styles.
import '../styles/portfolio.css';
import '../styles/card-interactions.css';
import '../styles/portfolio-panels.css';

interface Props { welcome?: boolean; title?: string; description?: string }
const { welcome = false, title = site.seo.title, description = site.seo.description } = Astro.props;
const canonical = site.seo.url;
---
<!doctype html>
<html lang="en" data-portfolio-view="home" data-entry-storage-key={site.entryStorageKey}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline define:vars={{ welcome, entryStorageKey: site.entryStorageKey }}>
      // Hide only foreground content before first paint. Without JS, the page stays accessible.
      (() => {
        const root = document.documentElement;
        // Remember entry for this tab; panels always start at Home on a fresh document.
        let entered = false;
        try { entered = sessionStorage.getItem(entryStorageKey) === 'true'; } catch {}
        if (!welcome || entered) {
          root.dataset.entry = 'entered';
          try { sessionStorage.setItem(entryStorageKey, 'true'); } catch {}
          return;
        }
        root.dataset.entry = 'welcome';
        root.classList.add('entry-pending');
        // Fail open if the interaction module cannot load; never strand visitors at the gate.
        const recovery = window.setTimeout(() => {
          root.removeAttribute('data-entry');
          root.classList.remove('entry-pending');
          const contact = document.querySelector('[data-contact]');
          contact?.removeAttribute('inert');
          contact?.removeAttribute('aria-hidden');
          const welcome = document.querySelector('[data-welcome]');
          if (welcome) welcome.hidden = true;
        }, 5000);
        document.addEventListener('entry:ready', () => window.clearTimeout(recovery), { once: true });
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F8F4E8" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={assetUrl('/images/favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
