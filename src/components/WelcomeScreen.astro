    <h1 class="welcome-heading" id="welcome-heading" aria-label="welcome."><span class="welcome-word" aria-hidden="true"><span>welcome</span><span class="welcome-period">.</span></span></h1>
    <div class="welcome-button-reveal">
      <div class="welcome-button-idle">
        <button class="play-button enter-button" type="button" data-enter>Enter my space <span aria-hidden="true">→</span></button>
