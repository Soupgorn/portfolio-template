---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<section class="music" aria-labelledby="music-heading" data-now-playing data-spotify-enabled={String(site.music.enabled)}>
  <h2 id="music-heading" class="music-heading eyebrow">On repeat</h2>
  <div class="music-container">
    <div class="live-card" data-live-card data-status={site.music.enabled ? 'unavailable' : 'unconfigured'}>
      <div class="live-topline">
        <span class="listening-status" data-status-label role="status"><span class="live-dot" aria-hidden="true"></span><span data-status-text>{site.music.enabled ? 'UNAVAILABLE' : 'UNCONFIGURED'}</span></span>
      </div>
      <div class="track-stage" data-track-stage>
        <div class="track-layer" data-track-layer>
          <div class="artwork-frame">
            <span class="artwork-placeholder"><Icon name="note" size={36} /></span>
            <img data-artwork hidden alt="" width="120" height="120" referrerpolicy="no-referrer" />
          </div>
          <div class="track-copy">
            <h3 data-track-title>{site.music.enabled ? 'Spotify is taking a break.' : 'Your soundtrack starts here.'}</h3>
            <p class="track-artist" data-track-artist>{site.music.enabled ? 'please try again later.' : 'Connect Spotify when you’re ready.'}</p>
          </div>
        </div>
      </div>
      <div class="playback-progress" data-progress hidden>
        <div class="progress-track" role="progressbar" aria-label="Approximate track progress" aria-valuemin="0" aria-valuemax="100" data-progress-bar><span data-progress-fill></span></div>
        <div class="progress-times"><span data-elapsed>0:00</span><span data-duration>0:00</span></div>
      </div>
      <div class="spotify-footer">
        <span class="spotify-wordmark"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="currentColor"/><path d="M5.2 9c4-1.2 9-1 13 1.1M6 12.1c3.5-1 7.9-.8 11.1 1M6.8 15.1c3-.8 6.3-.5 9.1 1" fill="none" stroke="#142C22" stroke-width="1.5" stroke-linecap="round"/></svg>Spotify</span>
        <a class="spotify-link" data-spotify-link hidden target="_blank" rel="noopener noreferrer">Open in Spotify <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
      </div>
      <noscript><p class="live-noscript">Enable JavaScript to check listening status.</p></noscript>
    </div>
  </div>
</section>
<script>
  import { mountNowPlaying } from '../scripts/spotify-now-playing';
  const mount = () => document.querySelectorAll<HTMLElement>('[data-now-playing]').forEach(mountNowPlaying);
  mount();
</script>
<style>
  .music-container { padding: 10px; border: 1px solid var(--stroke-subtle); border-radius: 20px; background: var(--color-soft-green); }
  .live-card { display: grid; padding: 22px 18px 12px; border: 1px solid #526c57; border-radius: 14px; background: #142C22; color: var(--color-cream); }
  .live-topline { display: flex; align-items: center; justify-content: flex-end; gap: 8px; margin-bottom: 18px; }
  .listening-status { display: inline-flex; align-items: center; gap: 6px; font: 9px var(--font-label); letter-spacing: .06em; color: #bdcdbb; }
  .live-dot { width: 5px; height: 5px; flex-shrink: 0; border-radius: 50%; background: #bdcdbb; }
  .live-card[data-status="playing"] .listening-status { color: #bde8aa; }
  .live-card[data-status="playing"] .live-dot { background: #a8dc8b; animation: live-pulse 4.5s ease-in-out infinite; }
  .live-card[data-status="paused"] .listening-status { color: #e3ce8d; }
  .live-card[data-status="paused"] .live-dot { background: #d7bd73; }
  .track-stage { display: grid; min-width: 0; }
  .track-stage > :global(.track-layer) { grid-area: 1 / 1; min-width: 0; text-align: center; }
  .artwork-frame { position: relative; display: grid; place-items: center; width: 120px; height: 120px; margin: 0 auto 20px; border: 1px solid #526c57; border-radius: 12px; overflow: hidden; background: #203c2e; color: #a6ba9d; }
  .artwork-frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }
  .track-copy { min-width: 0; }
  .track-copy h3 { margin: 0; font-family: var(--font-display); font-size: 24px; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
  .track-artist { margin: 8px 0 0; color: #c2d1bd; font-size: 19px; font-weight: 500; line-height: 1.5; overflow-wrap: anywhere; }
  .playback-progress { margin-top: 18px; }
  .progress-track { height: 3px; overflow: hidden; border-radius: 8px; background: #456047; }
  .progress-track span { display: block; height: 100%; width: 0; border-radius: inherit; background: #b5d39c; }
  .live-card[data-status="playing"] [data-progress-fill] { transition: width 250ms linear; }
  .progress-times { display: flex; justify-content: space-between; margin-top: 7px; color: #c2d1bd; font: 9px var(--font-label); }
  .spotify-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 8px; min-height: 45px; margin-top: 18px; border-top: 1px solid #36513b; }
  .spotify-wordmark { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: #c2d1bd; }
  .spotify-link { display: inline-flex; align-items: center; gap: 4px; min-height: 44px; font-size: 10px; color: #d9e8cc; text-decoration: none; }
  .spotify-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .spotify-link:focus-visible { outline: 2px solid #b5d39c; outline-offset: 3px; border-radius: 4px; }
  .live-noscript { font-size: 10px; color: #c2d1bd; }
  @keyframes live-pulse { 0%, 100% { opacity: 1; box-shadow: 0 0 0 0 #a8dc8b00; } 50% { opacity: .7; box-shadow: 0 0 0 3px #a8dc8b18; } }
  :global(.entry-reveal) .music { animation: music-fade-in 300ms ease-out 450ms both; }
  @keyframes music-fade-in { from { opacity: 0; } to { opacity: 1; } }
  @media (min-width: 640px) {
    .live-card { padding: 24px 24px 12px; }
    .live-topline { grid-area: 1 / 1; align-self: start; justify-self: end; z-index: 1; margin: 8px 0 0; }
    .track-stage { grid-area: 1 / 1; }
    .track-stage > :global(.track-layer) { display: grid; grid-template-columns: 128px minmax(0, 1fr); align-items: start; gap: 24px; text-align: left; }
    .artwork-frame { width: 128px; height: 128px; margin: 0; }
    .track-copy { padding: 2px 88px 0 0; }
  }
  @media (max-width: 639px) { .track-copy h3 { font-size: clamp(20px, 5vw, 22px); } .track-artist { font-size: clamp(16px, 4.5vw, 18px); } }
  @media (max-width: 359px) { .music-container { padding: 6px; } .live-card { display: grid; padding: 18px 12px 10px; } .artwork-frame { width: 105px; height: 105px; } }
  @media (prefers-reduced-motion: reduce) { .music, .live-dot { animation: none !important; } [data-progress-fill] { transition: none !important; } }
</style>
