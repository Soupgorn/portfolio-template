---
import { site } from '../data/site';
import { parseSpotifyPlaylist } from '../lib/spotify';
import Icon from './Icon.astro';
const { music } = site;
const playlist = parseSpotifyPlaylist(music.playlistUrl);
---
<section class="music" aria-labelledby="music-heading">
  <div class="music-heading flex items-center justify-between">
    <h2 id="music-heading" class="eyebrow">On repeat</h2>
    <div class="equalizer flex items-end gap-1" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  </div>
  <div class="playlist-player">
    {playlist ? (
      <iframe class="spotify-embed" src={playlist.embedUrl} title={`Spotify playlist: ${music.playlistName}`}
        width="100%" height="352" loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" allowfullscreen
      ></iframe>
    ) : (
      <div class="playlist-placeholder">
        <span class="placeholder-icon"><Icon name="note" size={30} /></span>
        <p class="eyebrow">A space for good songs</p>
        <h3>Spotify playlist coming soon</h3>
        <p>A few favorites will find their home here.</p>
      </div>
    )}
  </div>
  <div class="playlist-details">
    <div class="playlist-identity">
      <Icon name="note" size={18} />
      <div class="playlist-copy">
        <p class="eyebrow">My playlist</p>
        <p class="playlist-name">{music.playlistName}</p>
      </div>
    </div>
    {playlist && (
      <a class="spotify-link" href={playlist.url} target="_blank" rel="noopener noreferrer">
        Open in Spotify <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
      </a>
    )}
  </div>
  <aside class="music-note" aria-label="A personal music note">
    <svg class="headphone-icon" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 14v-3a9 9 0 0 1 18 0v3" /><rect x="3" y="12" width="4" height="8" rx="2" /><rect x="17" y="12" width="4" height="8" rx="2" />
    </svg>
    <p>{music.tagline}</p>
    <div class="music-dots" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  </aside>
</section>
<style>
  .playlist-player { padding: 10px; border: 1px solid var(--stroke-subtle); border-radius: 16px; background: var(--surface-quiet); }
  .spotify-embed { display: block; width: 100%; max-width: 100%; height: 352px; border: 0; border-radius: 12px; }
  .playlist-placeholder { min-height: 352px; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 24px 14px; text-align: center; }
  .placeholder-icon { display: grid; place-items: center; width: 60px; height: 60px; margin-bottom: 24px; border: 1px solid var(--stroke-subtle); border-radius: 20px; color: var(--color-signature-green); background: var(--color-soft-green); }
  .playlist-placeholder h3 { max-width: 220px; margin: 12px 0 0; font-family: var(--font-display); font-size: 23px; line-height: 1.3; font-weight: 500; text-wrap: balance; }
  .playlist-placeholder > p:last-child { max-width: 200px; margin: 14px 0 0; font-size: 12px; line-height: 1.7; color: var(--color-muted); }
  .playlist-details { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 16px; margin: 18px 0 24px; }
  .playlist-identity { display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1 1 140px; }
  .playlist-identity > :global(svg) { flex-shrink: 0; color: var(--color-signature-green); }
  .playlist-copy { min-width: 0; }
  .playlist-copy .eyebrow { font-size: 9px; }
  .playlist-name { margin: 4px 0 0; font-size: 12px; line-height: 1.6; font-weight: 500; overflow-wrap: anywhere; }
  .spotify-link { display: inline-flex; align-items: center; gap: 5px; min-height: 44px; color: var(--color-signature-green); font-size: 11px; line-height: 1.5; text-underline-offset: 4px; }
  .spotify-link:focus-visible { outline: 3px solid var(--color-signature-green); outline-offset: 4px; border-radius: 3px; }
  .music-note { position: relative; isolation: isolate; overflow: hidden; padding: 26px; border: 1px solid var(--stroke-subtle); border-radius: 16px; background: var(--color-cream); transition: border-color 200ms ease; }
  .music-note::before, .music-note::after { content: ""; position: absolute; z-index: -1; pointer-events: none; background: var(--color-soft-green); }
  .music-note::before { width: 120px; height: 150px; right: -45px; top: -45px; border-radius: 50% 40% 60% 45%; transform: rotate(-25deg); opacity: .7; }
  .music-note::after { width: 80px; height: 80px; right: 24px; bottom: -60px; border-radius: 50%; opacity: .5; }
  .headphone-icon { color: var(--color-signature-green); }
  .music-note p { max-width: 220px; margin: 14px 0 18px; font-family: var(--font-display); font-size: 22px; font-weight: 500; line-height: 1.35; letter-spacing: -.025em; overflow-wrap: anywhere; text-wrap: balance; }
  .music-dots { display: flex; gap: 6px; }
  .music-dots span { width: 5px; height: 5px; border-radius: 50%; background: var(--color-signature-green); }
  .music-dots span:last-child { background: var(--color-red); }
  :global(:root:is([data-entry="entered"], :not([data-entry]))) .music-dots { animation: music-dot-pulse 5s ease-in-out infinite; }
  :global(:root[data-motion-paused]) .music-dots { animation-play-state: paused; }
  :global(.entry-reveal) .music { animation: music-fade-in 300ms ease-out 450ms both; }
  @keyframes music-fade-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes music-dot-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .65; } }
  @media (hover: hover) { .music-note:hover { border-color: var(--stroke-strong); } }
  @media (max-width: 359px) { .playlist-player { padding: 6px; } }
  @media (prefers-reduced-motion: reduce) { .music, .music-dots { animation: none !important; } .music-note { transition: none; } }
</style>
