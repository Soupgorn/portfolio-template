---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<section class="music" aria-labelledby="music-heading" data-now-playing data-spotify-enabled={String(site.music.enabled)}>
  <div class="music-heading flex items-center justify-between">
    <h2 id="music-heading" class="eyebrow">On repeat</h2>
    <div class="equalizer flex items-end gap-1" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  </div>
  <div class="music-container">
    <div class="live-card" data-live-card data-status={site.music.enabled ? 'unavailable' : 'offline'}>
      <div class="live-topline">
        <p class="eyebrow">Now playing</p>
        <span class="listening-status" data-status-label role="status"><span class="live-dot" aria-hidden="true"></span><span data-status-text>{site.music.enabled ? 'UNAVAILABLE' : 'OFFLINE'}</span></span>
      </div>
      <div class="track-stage" data-track-stage>
        <div class="track-layer" data-track-layer>
          <div class="artwork-frame">
            <span class="artwork-placeholder"><Icon name="note" size={36} /></span>
            <img data-artwork hidden alt="" width="120" height="120" referrerpolicy="no-referrer" />
          </div>
          <div class="track-copy">
            <h3 data-track-title>A quiet moment</h3>
            <p class="track-artist" data-track-artist>{site.music.enabled ? 'Listening status is unavailable.' : 'Your soundtrack starts here.'}</p>
            <p class="track-album" data-track-album>&nbsp;</p>
          </div>
        </div>
      </div>
      <div class="progress-space">
        <div class="playback-progress" data-progress hidden>
          <div class="progress-track" role="progressbar" aria-label="Approximate track progress" aria-valuemin="0" aria-valuemax="100" data-progress-bar><span data-progress-fill></span></div>
          <div class="progress-times"><span data-elapsed>0:00</span><span data-duration>0:00</span></div>
          <p class="progress-hint">approximate · updated every 30s</p>
        </div>
      </div>
      <div class="spotify-footer">
        <span class="spotify-wordmark"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="currentColor"/><path d="M5.2 9c4-1.2 9-1 13 1.1M6 12.1c3.5-1 7.9-.8 11.1 1M6.8 15.1c3-.8 6.3-.5 9.1 1" fill="none" stroke="#142C22" stroke-width="1.5" stroke-linecap="round"/></svg>Spotify</span>
        <a class="spotify-link" data-spotify-link hidden target="_blank" rel="noopener noreferrer">Open in Spotify <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
      </div>
      {site.music.enabled && <noscript><p class="live-noscript">Enable JavaScript to check listening status.</p></noscript>}
    </div>
  </div>
  <aside class="music-note" aria-label="A music note">
    <svg class="headphone-icon" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 14v-3a9 9 0 0 1 18 0v3" /><rect x="3" y="12" width="4" height="8" rx="2" /><rect x="17" y="12" width="4" height="8" rx="2" />
    </svg>
    <p>{site.music.tagline}</p>
    <div class="music-dots" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  </aside>
</section>
<script>
  import { mountNowPlaying } from '../scripts/spotify-now-playing';
  document.querySelectorAll<HTMLElement>('[data-now-playing]').forEach(mountNowPlaying);
</script>
<style>
  .music-container { padding: 10px; border: 1px solid var(--stroke-subtle); border-radius: 20px; background: var(--color-soft-green); margin-bottom: 20px; }
  .live-card { padding: 22px 18px 12px; border: 1px solid #526c57; border-radius: 14px; background: #142C22; color: var(--color-cream); }
  .live-topline { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 22px; }
  .live-topline .eyebrow { color: #bdcdbb; font-size: 9px; }
  .listening-status { display: inline-flex; align-items: center; gap: 6px; font: 9px var(--font-label); letter-spacing: .06em; color: #bdcdbb; }
  .live-dot { width: 5px; height: 5px; flex-shrink: 0; border-radius: 50%; background: #bdcdbb; }
  .live-card[data-status="playing"] .listening-status { color: #bde8aa; }
  .live-card[data-status="playing"] .live-dot { background: #a8dc8b; animation: live-pulse 4.5s ease-in-out infinite; }
  .track-stage { display: grid; min-width: 0; }
  .track-stage > :global(.track-layer) { grid-area: 1 / 1; min-width: 0; text-align: center; }
  .artwork-frame { position: relative; display: grid; place-items: center; width: 120px; height: 120px; margin: 0 auto 20px; border: 1px solid #526c57; border-radius: 12px; overflow: hidden; background: #203c2e; color: #a6ba9d; }
  .artwork-frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; border-radius: inherit; }
  .track-copy { min-width: 0; }
  .track-copy h3 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; min-height: 50px; margin: 0; font-family: var(--font-display); font-size: 20px; font-weight: 500; line-height: 1.25; overflow-wrap: anywhere; }
  .track-artist { margin: 8px 0 0; color: #c2d1bd; font-size: 12px; line-height: 1.6; height: 39px; overflow: hidden; overflow-wrap: anywhere; }
  .track-album { margin: 5px 0 0; color: #a7bda3; font-size: 10px; line-height: 1.5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .progress-space { height: 70px; padding-top: 18px; }
  .progress-track { height: 3px; overflow: hidden; border-radius: 8px; background: #456047; }
  .progress-track span { display: block; height: 100%; width: 0; border-radius: inherit; background: #b5d39c; }
  .progress-times { display: flex; justify-content: space-between; margin-top: 7px; color: #c2d1bd; font: 9px var(--font-label); }
  .progress-hint { margin: 6px 0 0; font: 8px var(--font-label); color: #a7bda3; text-align: center; }
  .spotify-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 8px; min-height: 45px; border-top: 1px solid #36513b; }
  .spotify-wordmark { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: #c2d1bd; }
  .spotify-link { display: inline-flex; align-items: center; gap: 4px; min-height: 44px; font-size: 10px; color: #d9e8cc; text-decoration: none; }
  .spotify-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .spotify-link:focus-visible { outline: 2px solid #b5d39c; outline-offset: 3px; border-radius: 4px; }
  .live-noscript { font-size: 10px; color: #c2d1bd; }
  @keyframes live-pulse { 0%, 100% { opacity: 1; box-shadow: 0 0 0 0 #a8dc8b00; } 50% { opacity: .7; box-shadow: 0 0 0 3px #a8dc8b18; } }
  .music-note { position: relative; isolation: isolate; overflow: hidden; padding: 26px; border: 1px solid var(--stroke-subtle); border-radius: 16px; background: var(--color-cream); transition: border-color 200ms ease; }
  .music-note::before, .music-note::after { content: ""; position: absolute; z-index: -1; pointer-events: none; background: var(--color-soft-green); }
  .music-note::before { width: 120px; height: 150px; right: -45px; top: -45px; border-radius: 50% 40% 60% 45%; transform: rotate(-25deg); opacity: .7; }
  .music-note::after { width: 80px; height: 80px; right: 24px; bottom: -60px; border-radius: 50%; opacity: .5; }
  .headphone-icon { color: var(--color-signature-green); }
  .music-note p { max-width: 220px; margin: 14px 0 18px; font-family: var(--font-display); font-size: 22px; font-weight: 500; line-height: 1.35; letter-spacing: -.025em; overflow-wrap: anywhere; text-wrap: balance; }
  .music-dots { display: flex; gap: 6px; }
  .music-dots span { width: 5px; height: 5px; border-radius: 50%; background: var(--color-signature-green); }
  .music-dots span:last-child { background: var(--color-red); }
  :global(:root:is([data-entry="entered"], :not([data-entry]))) .music-dots { animation: music-dot-pulse 5s ease-in-out infinite; }
  :global(:root[data-motion-paused]) .music-dots { animation-play-state: paused; }
  :global(.entry-reveal) .music { animation: music-fade-in 300ms ease-out 450ms both; }
  @keyframes music-fade-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes music-dot-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .65; } }
  @media (hover: hover) { .music-note:hover { border-color: var(--stroke-strong); } }
  @media (max-width: 359px) { .music-container { padding: 6px; } .live-card { padding: 18px 12px 10px; } .artwork-frame { width: 105px; height: 105px; } }
  @media (prefers-reduced-motion: reduce) { .music, .music-dots, .live-dot { animation: none !important; } .music-note { transition: none; } }
</style>
