---
import type { Project } from '../data/projects';
import { projectImages, projectSourceUrl, projectUrl } from '../lib/projects';
import Icon from './Icon.astro';
import ProjectImage from './ProjectImage.astro';

interface Props { project: Project; dialogId?: string }
const { project, dialogId } = Astro.props;

const githubUrl = projectSourceUrl(project);
const demoUrl = projectUrl(project.demoUrl);
const image = projectImages(project)[0];
---
<article class="project-card">
  <ProjectImage image={image} />
  <div class="project-body">
    {(project.category || project.featured) && <p class="project-category">{project.category}{project.category && project.featured && <span aria-hidden="true"> · </span>}{project.featured && 'Featured'}</p>}
    <h2 class="project-title">{project.title}</h2>
    <p class="project-description">{project.description}</p>
    {project.technologies.length > 0 && <ul class="project-technologies" aria-label="Technologies" role="list">{project.technologies.map(technology => <li>{technology}</li>)}</ul>}
    {dialogId ? (
      <>
        <button class="project-open" type="button" data-project-open={dialogId} aria-controls={dialogId} aria-haspopup="dialog" aria-expanded="false" aria-label={`Explore ${project.title}`} disabled>Explore project<Icon name="arrow" size={16} /></button>
        <noscript>{githubUrl ? <a href={githubUrl} target="_blank" rel="noopener noreferrer">View on GitHub (opens in a new tab)</a> : <p>Enable JavaScript to explore project details.</p>}</noscript>
      </>
    ) : (githubUrl || demoUrl) && <div class="project-links">
      {githubUrl && <a href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label={`View ${project.title} on GitHub (opens in a new tab)`}><Icon name="github" size={17} />GitHub</a>}
      {demoUrl && <a href={demoUrl} target="_blank" rel="noopener noreferrer" aria-label={`View ${project.title} live demo (opens in a new tab)`}>Live demo<Icon name="arrow" size={16} /></a>}
    </div>}
  </div>
</article>

<style>
  .project-card { position: relative; min-width: 0; display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--stroke-subtle); border-radius: 16px; background: var(--surface-quiet); transition: border-color 220ms ease; }
  .project-body { flex: 1; display: flex; flex-direction: column; align-items: flex-start; padding: 24px; }
  .project-category { margin: 0 0 10px; color: var(--color-signature-green); font-size: 12px; font-weight: 600; overflow-wrap: anywhere; }
  .project-title { margin: 0; font-family: var(--font-display); font-size: 24px; font-weight: 600; letter-spacing: -.03em; line-height: 1.25; overflow-wrap: anywhere; }
  .project-description { margin: 12px 0 0; color: var(--color-muted); font-size: 14px; line-height: 1.75; overflow-wrap: anywhere; }
  .project-technologies { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 0; padding: 0; list-style: none; }
  .project-technologies li { max-width: 100%; padding: 5px 10px; border: 1px solid var(--stroke-subtle); border-radius: 999px; background: var(--color-cream); font-size: 11px; line-height: 1.6; overflow-wrap: anywhere; }
  .project-links { display: flex; flex-wrap: wrap; gap: 4px 20px; margin-top: auto; padding-top: 20px; }
  .project-links a { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; color: var(--color-ink); font-size: 13px; font-weight: 600; text-decoration: underline; text-decoration-color: var(--stroke-strong); text-underline-offset: 5px; }
  .project-open { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; margin-top: auto; padding: 20px 0 0; border: 0; background: transparent; color: var(--color-ink); font: 600 13px var(--font-sans); text-decoration: underline; text-decoration-color: var(--stroke-strong); text-underline-offset: 5px; }
  .project-open:not(:disabled)::after { content: ''; position: absolute; inset: 0; cursor: pointer; }
  .project-card:focus-within { border-color: var(--color-signature-green); }
  noscript a, noscript p { font-size: 13px; line-height: 1.75; }
  @media (hover: hover) { .project-card:hover { border-color: var(--stroke-strong); } .project-links a:hover { color: var(--color-signature-green); text-decoration-color: currentColor; } }
  @media (prefers-reduced-motion: reduce) { .project-card { transition: none; } }
</style>
