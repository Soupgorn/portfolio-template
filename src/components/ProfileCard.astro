---
import { site } from '../data/site';
import ProfilePhotoLightbox from './ProfilePhotoLightbox.astro';
---
<section class="profile" aria-labelledby="profile-name">
  <ProfilePhotoLightbox />
  <div class="profile-intro">
    <p class="eyebrow intro-label"><span class="hero-eyebrow-idle">{site.introLabel}</span></p>
    <h1 id="profile-name"><span class="hero-name-idle">{site.name}</span></h1>
    <p class="profile-subtitle profile-full-name"><span>{site.subtitle}</span>{' '}<strong class="profile-nickname">({site.tagline})</strong></p>
  </div>
</section>

<style>
  .profile-full-name {
    margin: 8px 0 0;
    font-family: var(--font-sans);
    font-size: 15.5px;
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-muted);
    text-align: left;
    overflow-wrap: anywhere;
  }

  .profile-nickname {
    font-weight: 700;
    color: var(--color-ink);
    white-space: nowrap;
  }
</style>
