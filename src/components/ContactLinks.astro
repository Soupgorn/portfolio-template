---
import { site, type Contact } from '../data/site';
import Icon from './Icon.astro';

// Keep accidental placeholder, relative, and unsafe URLs from becoming active links.
function isConfigured(contact: Contact): boolean {
  if (contact.platform === 'email') return /^mailto:[^\s@]+@[^\s@]+\.[^\s@]+$/i.test(contact.href ?? '');
  try {
    const url = new URL(contact.href ?? '');
    return url.protocol === 'https:' && !url.username && !url.password;
  } catch { return false; }
}
---
<footer id="contact" class="contacts" aria-labelledby="contact-heading" tabindex="-1">
  <div class="contact-copy">
    <h2 id="contact-heading" class="eyebrow">{site.contactLabel}</h2>
    <p class="contact-tagline">{site.contactTagline}</p>
  </div>
  <ul class="contact-grid" role="list">
    {site.contacts.map((contact, index) => (
      <li class="contact-item" style={`--contact-index: ${index}`}>
        {isConfigured(contact) ? (
          <a class="contact-link" href={contact.href} target={contact.platform === 'email' ? undefined : '_blank'} rel={contact.platform === 'email' ? undefined : 'noopener noreferrer'} aria-label={`${contact.label}${contact.platform === 'email' ? '' : ' (opens in a new tab)'}`}>
            <Icon name={contact.platform} size={21} />
          </a>
        ) : (
          <span class="contact-link contact-disabled" role="link" aria-disabled="true" aria-label={`${contact.label} (not configured)`}>
            <Icon name={contact.platform} size={21} />
          </span>
        )}
        <span class="contact-caption" aria-hidden="true">{contact.label}</span>
        <span class="contact-tooltip" aria-hidden="true">{contact.label}{!isConfigured(contact) && <small>Not configured</small>}</span>
      </li>
    ))}
  </ul>
  {site.contacts.every((contact) => !isConfigured(contact)) && <p class="sr-only">{site.contactPendingNote}</p>}
</footer>

<script>
  const mounted = new WeakSet<HTMLElement>();
  function mountContacts() {
    const footer = document.querySelector<HTMLElement>('.contacts');
    if (!footer || mounted.has(footer)) return;
    mounted.add(footer);
    const controller = new AbortController();
    const options = { signal: controller.signal };
    const items = footer.querySelectorAll<HTMLElement>('.contact-item');
    const dismiss = (item: HTMLElement) => {
      item.dataset.tooltipDismissed = 'true';
      delete item.dataset.tooltipFocused;
    };
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') items.forEach(item => { if (item.matches(':hover, :focus-within')) dismiss(item); });
    }, options);
    items.forEach(item => {
      item.addEventListener('pointerenter', () => { delete item.dataset.tooltipDismissed; }, options);
      item.addEventListener('pointerleave', () => { delete item.dataset.tooltipDismissed; }, options);
      item.addEventListener('pointerdown', () => { delete item.dataset.tooltipFocused; }, options);
      item.addEventListener('click', event => {
        if (event.target instanceof Element && event.target.closest('.contact-link')) dismiss(item);
      }, options);
      item.addEventListener('focusin', event => {
        if (event.target instanceof Element && event.target.matches('.contact-link:focus-visible')) {
          delete item.dataset.tooltipDismissed;
          item.dataset.tooltipFocused = 'true';
        }
      }, options);
      item.addEventListener('focusout', () => { delete item.dataset.tooltipFocused; }, options);
    });
    window.addEventListener('pagehide', event => { if (!event.persisted) controller.abort(); }, options);
  }
  mountContacts();
</script>
